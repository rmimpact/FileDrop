{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileDrop",
  "version": "1.1.2",
  "identifier": "com.remy.filedrop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/filedrop/browser"
  },
  "app": {
    "windows": [
      {
        "minWidth": 900,
        "minHeight": 650,
        "title": "FileDrop",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4NEYwRUJCQkJFOTZCRjIKUldUeWErbTd1dzVQdVBUeVFpRnhkY0I5ZWFqOUMzaDRLUE1hdUNTY1NRNkF3c0p1WCt2NURXVXYK",
      "endpoints": [
        "https://github.com/rmimpact/FileDrop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
